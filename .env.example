# RescueBite Environment Variables Template

# For local development with SQLite (zero setup):
DATABASE_URL="file:./dev.db"

# For Neon PostgreSQL on Vercel deployment:
# DATABASE_URL="postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/rescuebite?sslmode=require"

# JWT Secret for Session Authentication
NEXTAUTH_SECRET="your-32-character-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# Google Gemini API key (optional - intelligent fallback included if omitted)
GEMINI_API_KEY="your-gemini-api-key"

# Public metadata
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_HELPLINE="+91 97708 69581"
NEXT_PUBLIC_SUPPORT_EMAIL="hello@rescuebite.in"

